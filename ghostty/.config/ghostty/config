theme = "dark:Modest Dark,light:Modest Light"

cursor-style = block

font-family = "Operator Mono Book"
font-family-bold = "Operator Mono Book"
font-family-italic = "Operator Mono Book Italic"
font-family-bold-italic = "Operator Mono Book Italic"

font-size = 15

macos-titlebar-proxy-icon = "hidden"

keybind="global:alt+enter=new_window"

auto-update = "download"
macos-option-as-alt = true

quit-after-last-window-closed = true

shell-integration = zsh
shell-integration-features = ssh-env

window-height = 50
window-width = 168

unfocused-split-opacity = 1
split-divider-color = #1e242e

auto-update-channel = tip
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "disable_ai": false,
  "show_wrap_guides": true,
  "show_edit_predictions": false,
  "icon_theme": {
    "mode": "system",
    "dark": "Material Icon Theme",
    "light": "Material Icon Theme"
  },
  "confirm_quit": true,
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Modest Dark"
  },
  "ui_font_size": 16,
  "ui_font_family": "Operator Mono Lig",
  "buffer_font_size": null,
  "buffer_font_family": "Operator Mono Lig",
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "restore_on_startup": "none",
  "ssh_connections": [],
  "scrollbar": { "show": "never" },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": { "enabled": false }
  },
  "git_panel": { "dock": "bottom" },
  "indent_guides": { "enabled": false },
  "vertical_scroll_margin": 0,
  "remove_trailing_whitespace_on_save": true,
  "show_whitespaces": "all",
  "terminal": {
    "dock": "right",
    "default_width": 770,
    "toolbar": { "breadcrumbs": false }
  },
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
    "button": true,
    "enabled": true,
    "dock": "right"
  },
  "features": { "edit_prediction_provider": "none" },
  "outline_panel": { "default_width": 240 },
  "soft_wrap": "none",
  "wrap_guides": [80],
  "tab_size": 2,
  "languages": {
    "Rust": { "tab_size": 2 },
    "TOML": { "tab_size": 2 },
    "proto": { "tab_size": 2 },
    "Prisma": { "tab_size": 2 },
    "HCL": { "tab_size": 2 },
    "YAML": { "format_on_save": "on", "formatter": "prettier" }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.cargo",
    "**/.next",
    "**/target",
    "**/dist",
    "**/node_modules"
  ],
  "jupyter": { "enabled": false },
  "project_panel": { "indent_size": 10 },
  "tab_bar": { "show_nav_history_buttons": false },
  "tabs": { "file_icons": true },
  "show_signature_help_after_edits": false,
  "lsp": {
    "discord_presence": {
      "initialization_options": {
        "idle": { "timeout": 1800, "action": "clear_activity" }
      }
    }
  }
}

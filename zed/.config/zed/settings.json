        "provider": "zed.dev",
        "model": "claude-opus-4-6",
        "enable_thinking": false,
      },
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-4-6",
        "enable_thinking": false,
      },
    ],
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
    },
    "button": true,
    "enabled": true,
    "dock": "right",
  },
  "outline_panel": { "dock": "right", "default_width": 240 },
  "soft_wrap": "none",
  "wrap_guides": [80],
  "tab_size": 2,
  "languages": {
    "Rust": { "tab_size": 2 },
    "TOML": { "tab_size": 2 },
    "HCL": { "tab_size": 2 },

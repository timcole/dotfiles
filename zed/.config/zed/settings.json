{
  "agent_servers": {
    "claude": {
      "default_mode": "acceptEdits",
      "command": "/Users/tim/.local/state/fnm_multishells/95416_1775791051469/bin/claude-agent-acp",
      "type": "custom",
      "args": [],
    },
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
